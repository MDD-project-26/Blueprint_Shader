{
  "name": "bluprint-models",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:hero": "vite build --config vite.hero.config.ts",
    "preview:hero": "vite preview --config vite.hero.config.ts",
    "build:canvas": "vite build --config vite.canvas.config.ts",
    "preview:canvas": "vite preview --config vite.canvas.config.ts",
    "build:explainer1": "vite build --config vite.explainer1.config.ts",
    "preview:explainer1": "vite preview --config vite.explainer1.config.ts",
    "build:explainer2": "vite build --config vite.explainer2.config.ts",
    "preview:explainer2": "vite preview --config vite.explainer2.config.ts",
    "build:battery": "vite build --config vite.battery.config.ts",
    "preview:battery": "vite preview --config vite.battery.config.ts",
    "build:battery-sideways": "vite build --config vite.battery-sideways.config.ts",
    "preview:battery-sideways": "vite preview --config vite.battery-sideways.config.ts",
    "dev:battery-embed": "vite --config vite.battery-embed.config.ts",
    "build:battery-embed": "vite build --config vite.battery-embed.config.ts",
    "build:all": "tsc -b && vite build && vite build --config vite.hero.config.ts --outDir dist --emptyOutDir false"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "mediabunny": "^1.52.3",
    "motion": "^12.43.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
